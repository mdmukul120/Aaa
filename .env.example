# Supabase প্রজেক্ট (Settings → API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
PORT=8000
# চাইলে সার্ভার চালু হয়েই নিজে নিজে শিখতে থাকবে
AUTOLEARN=0

# শেখানো (/api/learn) ও অটো-লার্ন চালু/বন্ধ করতে এই টোকেন লাগবে (হেডার: x-admin-token)।
# খালি রাখলে যে-কেউ শেখাতে পারবে — পাবলিক সার্ভারে অবশ্যই একটা লম্বা এলোমেলো মান দিন।
ADMIN_TOKEN=
# ডেটাবেসে এর বেশি ডকুমেন্ট হলে নতুন শেখা থেমে যায় (Supabase ফ্রি ১ GB রক্ষা)
MAX_DOCS=40000
# ৫১২ MB র‍্যামের হোস্টে 1 দিন (ছোট n-gram মডেল)
LOW_MEM=0
# নিউরাল মডেল চালু (1) / বন্ধ (0)
NEURAL=1
